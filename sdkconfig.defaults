# Board: Waveshare ESP32-S3-Touch-LCD-1.85B (ESP32-S3R8, 16 MB flash, 8 MB octal PSRAM)
CONFIG_IDF_TARGET="esp32s3"

# Flash: 16 MB quad (verified with `esptool flash-id`: XMC, ID 0x4018)
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# 8 MB octal PSRAM embedded in the ESP32-S3R8
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_RODATA=y
CONFIG_SPIRAM_XIP_FROM_PSRAM=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# Performance (same as Waveshare's 02_lvgl_demo)
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_COMPILER_OPTIMIZATION_PERF=y
CONFIG_ESP32S3_INSTRUCTION_CACHE_32KB=y
CONFIG_ESP32S3_DATA_CACHE_64KB=y
CONFIG_ESP32S3_DATA_CACHE_LINE_64B=y
CONFIG_FREERTOS_HZ=1000

# LVGL 9
CONFIG_LV_OS_FREERTOS=y
CONFIG_LV_USE_CUSTOM_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=15
CONFIG_LV_OBJ_STYLE_CACHE=y
CONFIG_LV_DRAW_SW_DRAW_UNIT_CNT=2
CONFIG_LV_FONT_MONTSERRAT_16=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_28=y
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_USE_SYSMON=y
CONFIG_LV_USE_PERF_MONITOR=y

# Bluetooth: NimBLE, central only (the ELM327 adapter is the peripheral)
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_MEM_ALLOC_MODE_EXTERNAL=y
CONFIG_BT_NIMBLE_ATT_PREFERRED_MTU=247
CONFIG_BT_NIMBLE_LOG_LEVEL_WARNING=y

# app_main only starts things, then logs memory (2.3 KB used at most)
CONFIG_ESP_MAIN_TASK_STACK_SIZE=4096
CONFIG_LV_FONT_MONTSERRAT_48=y

# microSD: long file names for the ride logs
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=64

# Per-task stack use in the memory report (mem_report.c)
CONFIG_FREERTOS_USE_TRACE_FACILITY=y

# Internal RAM: measured with mem_report.c, see README "Memory"
# The two LVGL draw threads used under 2 KB of their default 8 KB each.
CONFIG_LV_DRAW_THREAD_STACK_SIZE=4096
# Non-ISR code to flash: internal RAM holds IRAM code and the heap together.
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_RINGBUF_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_SPI_MASTER_ISR_IN_IRAM=n
# BLE controller: one scan plus one connection, legacy advertising only (BLE 4 adapters)
CONFIG_BT_CTRL_BLE_MAX_ACT=2
CONFIG_BT_CTRL_DTM_ENABLE=n
CONFIG_BT_NIMBLE_50_FEATURE_SUPPORT=n
# The NimBLE host task runs the scan callback, which matches adapters and skips tyre sensors
# (it had 800 B unused at 4 KB before that)
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=5120
# Big static buffers marked EXT_RAM_BSS_ATTR live in PSRAM
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
